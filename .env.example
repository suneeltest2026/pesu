# --- Required ---------------------------------------------------------------
# Long random string; signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the database file lives. On Render, point this at the mounted disk.
DATABASE_PATH=./var/pesu.db

# Where admin-uploaded images are written. Leave blank in development;
# in production point it at a persistent disk so redeploys keep them.
UPLOADS_PATH=

# Public URL, used for payment redirects and links in emails.
PUBLIC_URL=https://pesu.ae

# --- First admin (only read when seeding) -----------------------------------
ADMIN_EMAIL=care@pesu.ae
ADMIN_PASSWORD=

# --- Card payments ----------------------------------------------------------
# Stripe secret key (sk_live_… in production, sk_test_… while testing).
# Leave blank and card payment simply doesn't appear at checkout.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint, from the Stripe dashboard:
# Developers -> Webhooks -> your endpoint -> Signing secret (whsec_…).
# Without it, payments are only confirmed when a customer returns to the
# success page — a closed tab would leave a paid order marked pending.
STRIPE_WEBHOOK_SECRET=

# --- Other payment methods --------------------------------------------------
ENABLE_COD=true
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_IBAN=

# --- Order emails (optional; the shop works without it) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PESU <care@pesu.ae>
